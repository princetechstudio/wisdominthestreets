# ---------- Wisdom In The Streets — Production Environment ----------
# All prefixed VITE_ are exposed to the client (public)

# Podcast platform profiles
VITE_SPOTIFY_SHOW_URL=https://open.spotify.com/show/wisdom-in-the-streets
VITE_APPLE_PODCASTS_URL=https://podcasts.apple.com/show/wisdom-in-the-streets
VITE_YOUTUBE_CHANNEL_URL=https://youtube.com/@WITSPodcast
VITE_RSS_FEED_URL=https://witspodcast.com/feed.xml

# Contact form endpoint (using Formspree - configure your own form ID)
VITE_FORM_ENDPOINT=https://formspree.io/f/mzbrnoqb

# Newsletter endpoint (using Mailchimp - configure your own)
VITE_NEWSLETTER_ACTION=https://witspodcast.us1.list-manage.com/subscribe/post?u=YOUR_USER_ID&id=YOUR_LIST_ID

# WhatsApp Business number (international format, no +)
VITE_WHATSAPP_NUMBER=233273996065

# Analytics (Google Analytics 4 - add your GA ID)
VITE_GA_ID=G-XXXXXXXXXX

# Podcast tracking (Chartable / Podtrac - optional for analytics)
VITE_PODTRAC_PREFIX=https://dts.podtrac.com/redirect.mp3/
